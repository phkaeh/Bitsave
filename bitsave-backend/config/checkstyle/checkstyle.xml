<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <!-- Enforce spaces instead of tabs for consistent indentation -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Limit line length to 120 characters (ignores imports and URLs) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <module name="TreeWalker">
        <!-- Prevent unused imports -->
        <module name="UnusedImports"/>

        <!-- Forbid wildcard imports (e.g., java.util.*) to avoid namespace conflicts -->
        <module name="AvoidStarImport"/>

        <!-- Enforce braces for if/else/for/while statements to prevent logic bugs -->
        <module name="NeedBraces"/>

        <!-- Prevent empty blocks (especially empty catch blocks) to ensure proper error handling -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_SWITCH"/>
        </module>

        <!-- Enforce official Java modifier order (e.g., 'public static final') -->
        <module name="ModifierOrder"/>

        <!-- Warn against comparing strings with '==' instead of '.equals()' -->
        <module name="StringLiteralEquality"/>

        <!-- Enforce standard naming conventions for classes and methods -->
        <module name="TypeName"/>
        <module name="MethodName"/>
    </module>
</module>